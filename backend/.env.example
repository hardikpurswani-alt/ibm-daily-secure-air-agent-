# AirGuard AI Backend Environment Configuration
# Copy to .env and populate real credentials. NEVER commit .env to version control.

# App & Security
APP_ENV=development
APP_SECRET_KEY=change-this-to-a-long-random-hex-secret-in-production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=120

# Database (defaults to local SQLite; set postgresql+psycopg://... for IBM Cloud Databases for PostgreSQL)
DATABASE_URL=sqlite:///./airguard.db

# IBM Cloud / watsonx.ai (IBM Granite)
# Sydney region default: https://au-syd.ml.cloud.ibm.com
IBM_CLOUD_API_KEY=
WATSONX_AI_API_KEY=
WATSONX_AI_URL=https://au-syd.ml.cloud.ibm.com
WATSONX_PROJECT_ID=
WATSONX_GRANITE_MODEL_ID=ibm/granite-3-8b-instruct
WATSONX_EMBEDDING_MODEL_ID=ibm/slate-125m-english-rtrvr

# IBM watsonx Orchestrate (Existing Main Coordinator Agent — DO NOT DUPLICATE)
# Editor link: https://au-syd.watson-orchestrate.cloud.ibm.com/build/agent/edit/9804aee5-5298-40dc-930c-46d17a839fde
# Service Instance URL format: https://api.au-syd.watson-orchestrate.cloud.ibm.com/instances/<TENANT_ID>
WATSONX_ORCHESTRATE_INSTANCE_URL=
WATSONX_ORCHESTRATE_API_KEY=
WATSONX_ORCHESTRATE_AGENT_ID=9804aee5-5298-40dc-930c-46d17a839fde

# Public AQI APIs (Optional keys for extra reference networks; CPCB India, NSW EPA, and Open-Meteo work with zero keys)
# Note: WAQI 'demo' token is intentionally rejected because it always returns Shanghai regardless of city.
WAQI_API_TOKEN=
OPENAQ_API_KEY=
AIRNOW_API_KEY=
DATA_GOV_IN_API_KEY=

# Public Backend URL (used when generating OpenAPI tool specs for IBM watsonx Orchestrate)
PUBLIC_BACKEND_URL=http://localhost:8000
